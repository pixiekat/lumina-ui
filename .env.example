# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
#
# Lumina UI talks to the `lumina_db` container defined in ../lumina/docker-compose.yml.
# That container is PostGIS (postgres:16 superset) bound to host loopback 127.0.0.1:5444.
# This committed default documents the SHAPE only — the real password lives in
# .env.local (gitignored). Credentials come from ../lumina/.env (LUMINA_POSTGRES_*).
DATABASE_URL="postgresql://lumina:CHANGEME@127.0.0.1:5444/luminadb?serverVersion=16&charset=utf8"

# Second, READ-ONLY connection: the ctomop patient database.
#
# The `ctomop_db` container (../lumina/docker-compose.yml) is plain postgres:15,
# published on host loopback 127.0.0.1:5432. Doctrine registers this as the
# `patients` connection; it has no entity manager, so nothing can write to it.
# Credentials come from ../lumina/.env (CTOMOP_POSTGRES_*). Real password in
# .env.local (gitignored) — this line documents the SHAPE only.
#
# Note the port differs from the DSN that EXACT uses internally: inside the
# Docker network it is ctomop_db:5432, but Symfony runs on the host, so we go
# through the published loopback port instead.
PATIENT_DATABASE_URL="postgresql://ctomop:CHANGEME@127.0.0.1:5432/ctomopdb?serverVersion=15&charset=utf8"

# Third, READ-ONLY connection: the EXACT clinical trials database.
#
# The `exact_db` container is PostGIS, published on host loopback
# 127.0.0.1:5433 (offset from ctomop's 5432). Doctrine registers this as the
# `trials` connection; like `patients` it has no entity manager, so it cannot
# be written to. Credentials come from ../lumina/.env (EXACT_POSTGRES_*).
#
# exact_db hosts two databases with an identical trials_trial schema:
#   exactdb      — EXACT's own Django database
#   ne_bc_trials — the curated breast-cancer trial set
# Swap the database name below to switch; no code changes are needed.
TRIALS_DATABASE_URL="postgresql://exact:CHANGEME@127.0.0.1:5433/exactdb?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
#MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###
